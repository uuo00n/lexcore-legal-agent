# 四选一: zhipu | deepseek | qwen | ollama
# 当前代码默认 provider 是 deepseek；也可以按需切换到 zhipu/qwen/ollama。
LLM_PROVIDER=deepseek

# === 云端 Provider Keys（按需填）===
DEEPSEEK_API_KEY=sk-xxx
# ZHIPU_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx

# === 模型/接入点覆盖（可选）===
# LLM_MODEL=deepseek-v4-pro
# LLM_BASE_URL_OVERRIDE=http://192.168.1.50:11434/v1
# LLM_FALLBACK_PROVIDERS=zhipu,qwen

# === 动态模型路由（可选）===
# 不配置时仍使用 LLM_PROVIDER/LLM_MODEL；配置后会按任务复杂度选择 fast/strong/long。
# SUPERVISOR_PROVIDER=deepseek
# SUPERVISOR_MODEL=deepseek-v4-flash-vision-exp
# PLANNER_PROVIDER=deepseek
# PLANNER_MODEL=deepseek-v4-flash-vision-exp
# FACT_AGENT_PROVIDER=deepseek
# FACT_AGENT_MODEL=deepseek-v4-flash-vision-exp
# CONTRACT_AGENT_PROVIDER=deepseek
# CONTRACT_AGENT_MODEL=deepseek-v4-pro
# 后台摘要、长期记忆、用户画像提取使用轻量模型，避免抢占主问答模型限额。
# MEMORY_EXTRACTOR_MODEL=deepseek-v4-flash
# LLM_ROUTE_FAST_PROVIDER=deepseek
# LLM_ROUTE_FAST_MODEL=deepseek-v4-flash
# LLM_ROUTE_STRONG_PROVIDER=deepseek
# LLM_ROUTE_STRONG_MODEL=deepseek-v4-pro
# LLM_ROUTE_LONG_PROVIDER=deepseek
# LLM_ROUTE_LONG_MODEL=deepseek-v4-pro

# === 每日配额（0 表示不限制）===
LEGAL_DAILY_REQUEST_LIMIT=200
LEGAL_DAILY_TOKEN_LIMIT=200000

# === 缓存与后台权限 ===
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600
# 带上传合同/文书的回答单独用短 TTL，避免长期缓存合同正文
RESPONSE_CACHE_DOC_TTL_SECONDS=300
# 设置后 /api/admin/* 需要请求头 X-Admin-Key。
# ADMIN_API_KEY=change-me

# === Ollama 推荐用法 ===
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# === 本地 RAG 模型 ===
EMBEDDING_MODEL=models/bge-small-zh-v1.5
RERANKER_MODEL=models/bge-reranker-base

# === 向量存储（Qdrant；可改回 chroma）===
VECTOR_STORE=qdrant
CHROMA_DB_PATH=data/chroma_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_knowledge
QDRANT_TIMEOUT=5
# 开发或测试也可使用本地模式：QDRANT_PATH=:memory:

# === HyDE 查询增强（默认走 DeepSeek deepseek-v4-flash）===
HYDE_ENABLED=true
HYDE_BACKEND=openai
HYDE_MODEL=deepseek-v4-flash
HYDE_LLM_BASE_URL=https://api.deepseek.com
# 默认复用 DEEPSEEK_API_KEY；如需单独给 HyDE 配 key，可设置 HYDE_API_KEY。
# HYDE_API_KEY=sk-xxx
# 旧本地小模型配置先注释保留，后续需要可改回：
# HYDE_MODEL=qwen2.5:1.5b
# HYDE_LLM_BASE_URL=http://localhost:11434/v1
HYDE_REWRITE_ENABLED=true
HYDE_HF_MODEL_PATH=models/Qwen2.5-7B-Instruct
HYDE_LORA_PATH=models/qwen2_5_hyde_lora
HYDE_HF_MAX_NEW_TOKENS=220
HYDE_HF_TEMPERATURE=0.2

# === 检索参数 ===
RETRIEVAL_VECTOR_TOP_K=10
RETRIEVAL_BM25_TOP_K=10
RETRIEVAL_FINAL_TOP_K=5
RERANKER_SCORE_THRESHOLD=0.3
RRF_K=60
MAX_TOOL_CALLS=5

# === 得理法律开放平台 ===
DELILEGAL_BASE_URL=https://openapi.delilegal.com
DELILEGAL_APP_ID=your_app_id
DELILEGAL_SECRET=your_secret
DELILEGAL_LAW_SEARCH_PATH=/api/qa/v3/search/queryListLaw
DELILEGAL_CASE_SEARCH_PATH=/api/qa/v3/search/queryListCase
# DELILEGAL_CONNECT_TIMEOUT=5
# DELILEGAL_READ_TIMEOUT=30

# === OpenViking 真实接入（第二阶段，可选）===
# 需要先单独启动 OpenViking server，再运行 scripts/import_openviking_corpus.py 或 eval/run_eval.py --mode openviking_ab。
OPENVIKING_BASE_URL=http://localhost:1933
# OPENVIKING_API_KEY=your-openviking-key
# OPENVIKING_TIMEOUT=120
# OPENVIKING_ACCOUNT=
# OPENVIKING_USER=
# OPENVIKING_ACTOR_PEER_ID=

# === OpenViking 完整语义层运行时（GLM-4.7）===
# 生成配置：python scripts/render_openviking_config.py --show
# 启动服务：python scripts/start_openviking_glm47.py
# 完整导入：python scripts/import_openviking_corpus.py --article-cards --skills --write-mode upsert --no-write-wait --reindex-mode semantic_and_vectors --wait-after-import
# 旧实验配置使用过 ollama/qwen2.5，本配置不再使用本地 qwen 做 OpenViking 语义摘要。
OPENVIKING_CONTEXT_ENABLED=true
OPENVIKING_CONTEXT_TIMEOUT=3
OPENVIKING_CONTEXT_RESOURCE_LIMIT=4
OPENVIKING_CONTEXT_SKILL_LIMIT=3
OPENVIKING_CONTEXT_SCORE_THRESHOLD=0.45
OPENVIKING_CONTEXT_SKILL_DOMAIN_FILTER=true
OPENVIKING_RESOURCE_TARGET_URI=viking://resources/laws
OPENVIKING_SKILL_TARGET_URI=
OPENVIKING_WORKSPACE=.runtime/openviking/workspace
OPENVIKING_GLM_MODEL=glm-4.7
OPENVIKING_GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 默认复用 ZHIPU_API_KEY；如需单独给 OpenViking 配 key，可设置 OPENVIKING_GLM_API_KEY。
# OPENVIKING_GLM_API_KEY=sk-xxx
OPENVIKING_GLM_TIMEOUT=120
OPENVIKING_GLM_MAX_CONCURRENT=1
OPENVIKING_QUERY_PLANNER_MAX_CONCURRENT=1
OPENVIKING_EMBEDDING_API_BASE=http://localhost:11435/v1
OPENVIKING_EMBEDDING_MODEL=bge-small-zh-v1.5
OPENVIKING_EMBEDDING_DIMENSION=512

DOCS_DB=data/docs.sqlite
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10

# === PostgreSQL 持久化（infrastructure/）===
# 二选一：直接给完整 DSN，或用下面的分项拼装。DSN 里含密码，切勿提交真实值。
DATABASE_URL=postgresql+asyncpg://legal:change-me@localhost:5432/legal
# LangGraph 短期状态；测试或无数据库开发环境可改为 memory
CHECKPOINT_BACKEND=postgres
# 默认复用 DATABASE_URL，也可给 checkpointer 单独的 psycopg URL
# CHECKPOINT_DATABASE_URL=postgresql://legal:change-me@localhost:5432/legal
# 首次启动创建/升级 LangGraph 自有 checkpoint 表
# CHECKPOINT_AUTO_SETUP=true
# 限制 checkpoint 反序列化到已知安全类型
LANGGRAPH_STRICT_MSGPACK=true
# Checkpoint 只保存可恢复的工作流状态，不是长期用户 Memory；长期 Memory 使用独立向量存储。

# === Context Engineering / Memory ===
# 总输入预算与为模型输出预留的 token；实际 prompt 不得占用输出预留。
CONTEXT_INPUT_TOKEN_BUDGET=12000
CONTEXT_OUTPUT_TOKEN_RESERVE=2000
# 各层软预算：system / relevant memory / summary / recent messages / plan / evidence / task
CONTEXT_SYSTEM_TOKEN_BUDGET=1800
CONTEXT_MEMORY_TOKEN_BUDGET=900
CONTEXT_SUMMARY_TOKEN_BUDGET=700
CONTEXT_RECENT_MESSAGES_TOKEN_BUDGET=2600
CONTEXT_PLAN_TOKEN_BUDGET=700
CONTEXT_EVIDENCE_TOKEN_BUDGET=2400
CONTEXT_CURRENT_TASK_TOKEN_BUDGET=900
CONTEXT_RECENT_MESSAGE_COUNT=12
# 大 Tool observation 在送模型前转为结构化摘要；原始结果仍可由 collector 处理。
CONTEXT_TOOL_RESULT_TOKEN_BUDGET=500
# Working Memory 中的检索证据也按得分限制为 Top-N，防止跨轮累积。
CONTEXT_RETRIEVED_LAW_TOP_N=6
CONTEXT_RETRIEVED_CASE_TOP_N=4
# 长会话 checkpoint 压缩阈值；压缩后只保留最近消息和滚动摘要。
CONTEXT_WINDOW_TOKEN_BUDGET=12000
CONTEXT_AUTO_COMPACT_RATIO=0.75
CONTEXT_AUTO_COMPACT_MESSAGES=16
CONTEXT_COMPACTION_MODEL=deepseek-v4-flash
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=legal
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=legal
# 连接池与语句超时（0 表示不设超时）
# POSTGRES_POOL_SIZE=10
# POSTGRES_MAX_OVERFLOW=20
# POSTGRES_POOL_TIMEOUT=30
# POSTGRES_POOL_RECYCLE=1800
# POSTGRES_STATEMENT_TIMEOUT_MS=0
# PostgreSQL 不可用时是否阻止应用启动；生产环境应保持 true
# POSTGRES_REQUIRED=true
# 打开会把 SQL 打到日志，仅本地排障使用
# POSTGRES_ECHO=false

# === Redis 缓存 / 限流 / 会话元数据 / 幂等（infrastructure/redis.py、services/cache/）===
# Redis 只做可丢弃的热数据，不是长期 Memory 主数据库；留空即全部降级运行。
# 连接串可能含密码，切勿提交真实值。
REDIS_URL=redis://localhost:6379/0
# 显式开关；未设置时以 REDIS_URL 是否配置为准
# REDIS_ENABLED=true
# 所有 key 的全局前缀，便于与同实例上的其他应用隔离
# REDIS_KEY_PREFIX=legal
# 超时保持在 1s 量级：缓存层不允许拖慢主链
# REDIS_SOCKET_TIMEOUT=1.0
# REDIS_CONNECT_TIMEOUT=1.0
# REDIS_MAX_CONNECTIONS=20
# REDIS_HEALTH_CHECK_INTERVAL=30
# Redis 故障后熔断多少秒内直接降级，不再重试连接
# REDIS_BREAKER_COOLDOWN_SECONDS=30

# 检索结果缓存（Redis）
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=1800
# 得理 API 响应缓存（Redis）
DELILEGAL_CACHE_ENABLED=true
DELILEGAL_CACHE_TTL_SECONDS=3600
# 突发限流（Redis 固定窗口）；Redis 不可用时放行，由每日配额兜底
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# 会话元数据热层（Redis）；只存活跃时间与计数，不存标题与正文
SESSION_CACHE_ENABLED=true
SESSION_METADATA_TTL_SECONDS=86400
# 幂等标记（Redis SET NX EX）
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=600
